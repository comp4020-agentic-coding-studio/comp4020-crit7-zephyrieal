---
import { listBookings, listVenues, venueById } from "../lib/db";
import "../styles.css";

const bookings = listBookings();
const venues = listVenues();
const buildings = [...new Set(venues.map((venue) => venue.building))];

const ADVANCEABLE = new Set(["tentatively_assigned", "foc_pending", "foc_approved"]);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Book a venue</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Book a venue</h1>
      <p>
        Submit an event and headcount and get told, instantly, which room fits
        and which team owns it — no emailing five different venue-hire teams
        to find out.
      </p>
      <form method="post" action="/api/bookings">
        <label for="event">Event name</label>
        <input id="event" name="event" required />
        <label for="headcount">Headcount</label>
        <input id="headcount" name="headcount" type="number" min="1" required />
        <label for="building">Preferred building</label>
        <input id="building" name="building" list="buildings" placeholder="Any building" />
        <datalist id="buildings">
          {buildings.map((building) => <option value={building} />)}
        </datalist>
        <button>Request a venue</button>
      </form>

      <ul id="bookings">
        {bookings.map((booking) => {
          const venue = venueById(booking.venueId);
          return (
            <li data-booking-id={booking.id} data-status={booking.status}>
              <strong>{booking.event}</strong> — {booking.headcount} people
              <p>Status: {booking.status}</p>
              {venue ? (
                <p>
                  Assigned: {venue.name} ({venue.building}) — owned by{" "}
                  {venue.owningTeam}, <a href={`mailto:${venue.contactEmail}`}>{venue.contactEmail}</a>
                </p>
              ) : (
                <p>
                  No venue fits this headcount
                  {booking.preferredBuilding ? ` in ${booking.preferredBuilding}` : ""}.
                </p>
              )}
              {ADVANCEABLE.has(booking.status) && (
                <form method="post" action={`/api/bookings/${booking.id}/advance`}>
                  <button>Advance to next step</button>
                </form>
              )}
            </li>
          );
        })}
      </ul>
    </main>
  </body>
</html>
