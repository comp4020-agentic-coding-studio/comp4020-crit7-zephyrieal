---
import Layout from "../layouts/Layout.astro";
import VenueContact from "../components/VenueContact.astro";
import { listBookings, listVenues, venueById } from "../lib/db";

const bookings = listBookings();
const venues = listVenues();
const buildings = [...new Set(venues.map((venue) => venue.building))];

const STATUS_LABEL: Record<string, string> = {
  tentatively_assigned: "Room held (tentative)",
  foc_pending: "Awaiting FOC approval",
  foc_approved: "FOC approved",
  confirmed: "Confirmed",
  no_venue_available: "No room available",
};

const NEXT_ACTION: Record<string, string> = {
  tentatively_assigned: "Submit FOC form",
  foc_pending: "Mark FOC approved",
  foc_approved: "Confirm booking",
};

// Real deadlines from ANU's Functions on Campus page: 21 days' notice if the
// event has liquor, 14 days otherwise. The FOC step is the one stage in the
// real process that has a hard, published lead time, so it's the one place
// worth naming it rather than leaving the workflow's timing a mystery.
const NEXT_ACTION_HINT: Record<string, string> = {
  tentatively_assigned:
    "Functions on Campus needs 14 days' notice — 21 if the event has liquor.",
};

const STAMP_CLASS: Record<string, string> = {
  tentatively_assigned: "stamp stamp--amber",
  foc_pending: "stamp stamp--plum",
  foc_approved: "stamp stamp--blue",
  confirmed: "stamp stamp--confirmed",
  no_venue_available: "stamp stamp--flagged",
};
---

<Layout title="Venue clearance — book a room">
  <header class="masthead">
    <h1>Book a room, skip the inbox</h1>
    <p class="masthead__lede">
      Tell us the event and headcount. We match a room to the team that owns
      it, so you're not guessing which of five inboxes to try first.
    </p>
  </header>

  <div class="board-row">
    <section class="panel panel--paper" aria-labelledby="request-heading">
      <h2 id="request-heading">New request</h2>
      <form method="post" action="/api/bookings">
        <label for="event">Event name</label>
        <input id="event" name="event" required />

        <label for="headcount">Headcount</label>
        <input id="headcount" name="headcount" type="number" min="1" required />

        <label for="building">Preferred building</label>
        <select id="building" name="building">
          <option value="">Any building</option>
          {buildings.map((building) => <option value={building}>{building}</option>)}
        </select>

        <button type="submit">Request a room</button>
      </form>
      <p class="panel__hint">
        ANU Venue Hire quotes up to 5 business days to reply by email —
        commercial venues with their own booking site are usually faster.
      </p>
    </section>

    <section class="panel panel--directory" aria-labelledby="directory-heading">
      <h2 id="directory-heading">Who owns what</h2>
      <table>
        <thead>
          <tr>
            <th scope="col">Building</th>
            <th scope="col">Capacity</th>
            <th scope="col">Managed by</th>
          </tr>
        </thead>
        <tbody>
          {venues.map((venue) => (
            <tr>
              <th scope="row">{venue.building}</th>
              <td>up to {venue.capacity}</td>
              <td>
                {venue.owningTeam}
                <br />
                <VenueContact method={venue.contactMethod} contact={venue.contact} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>

  <section class="ledger" aria-labelledby="ledger-heading">
    <h2 id="ledger-heading">Ledger</h2>
    {
      bookings.length === 0 ? (
        <p class="ledger__empty">No requests yet — the first one you submit appears here.</p>
      ) : (
        <ul class="ledger__list">
          {bookings.map((booking) => {
            const venue = venueById(booking.venueId);
            const nextAction = NEXT_ACTION[booking.status];
            return (
              <li
                class="ledger-entry"
                data-booking-id={booking.id}
                data-status={booking.status}
              >
                <span class="ledger-entry__num">No. {String(booking.id).padStart(3, "0")}</span>
                <span class="ledger-entry__title">
                  {booking.event}{" "}
                  <span class="ledger-entry__headcount">for {booking.headcount} people</span>
                </span>
                <span class={STAMP_CLASS[booking.status]}>{STATUS_LABEL[booking.status]}</span>
                <p class="ledger-entry__detail">
                  {venue ? (
                    <>
                      {venue.name}, {venue.building} — owned by {venue.owningTeam},{" "}
                      <VenueContact method={venue.contactMethod} contact={venue.contact} />
                    </>
                  ) : (
                    <>
                      No room in the directory holds {booking.headcount} people
                      {booking.preferredBuilding ? ` in ${booking.preferredBuilding}` : ""}. Try a
                      smaller headcount, or widen your building preference.
                    </>
                  )}
                </p>
                {nextAction && (
                  <form
                    class="ledger-entry__action"
                    method="post"
                    action={`/api/bookings/${booking.id}/advance`}
                  >
                    <button type="submit">{nextAction}</button>
                    {NEXT_ACTION_HINT[booking.status] && (
                      <span class="ledger-entry__hint">{NEXT_ACTION_HINT[booking.status]}</span>
                    )}
                  </form>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</Layout>
