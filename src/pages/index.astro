---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Venue clearance — book a room">
  <header class="masthead">
    <h1>Book a room, skip the inbox</h1>
    <p class="masthead__lede">
      One place to ask for a room and find out who owns it. One place to see
      where a request already sits in the approval chain.
    </p>
  </header>

  <div class="choice-row">
    <a class="choice choice--paper" href="/request">
      <h2>New request</h2>
      <p>
        Tell us the event and headcount — we'll match a room to the team
        that owns it.
      </p>
    </a>
    <a class="choice choice--board" href="/requests">
      <h2>Your requests</h2>
      <p>
        Track a submitted request through Venue Hire and Functions on
        Campus approval.
      </p>
    </a>
  </div>
</Layout>
